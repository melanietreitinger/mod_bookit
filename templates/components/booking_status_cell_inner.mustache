{{!
    @template mod_bookit/components/booking_status_cell_inner
    Inner markup for the shared booking / resource status cell (no table wrapper).

    Context variables: see booking_status_cell::export_for_template().

    Example context (json):
    {
        "showoptions": false,
        "statustext": "New",
        "statusgrouptext": "Open request",
        "statusclass": "mod-bookit-status-new",
        "statusgroupkey": "new",
        "statusstyle": "background-color:#fff3cd;",
        "showhistorysummary": false,
        "showhistorydetails": false
    }
}}
{{#showoptions}}
<select class="custom-select custom-select-sm mod-bookit-status-select"
        data-action="{{updateaction}}"
        {{#eventid}}data-eventid="{{eventid}}"{{/eventid}}
        {{#cmid}}data-cmid="{{cmid}}"{{/cmid}}
        {{#itemid}}data-itemid="{{itemid}}"{{/itemid}}
        {{#bookingstatus}}data-bookingstatus="{{bookingstatus}}"{{/bookingstatus}}
        {{#requesttab}}data-tab="{{requesttab}}"{{/requesttab}}
        style="{{statusstyle}}">
    {{#options}}
    <option value="{{value}}" data-bg="{{bg}}" data-fg="{{fg}}" {{#selected}}selected{{/selected}}>{{label}}</option>
    {{/options}}
</select>
<div class="small text-muted mt-1">{{statusgrouptext}}</div>
{{#showhistorysummary}}
<div class="small text-muted mt-1">{{latesthistorysummary}}</div>
{{/showhistorysummary}}
{{#showhistorydetails}}
<details class="mt-2 text-left mod-bookit-history-details">
    <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
    {{#hashistoryentries}}
    <ul class="list-unstyled small mb-0 mt-2">
        {{#historyentries}}
        <li class="mb-2">
            <div>{{summary}}</div>
            {{#haschanges}}
            <ul class="mb-0 pl-3">
                {{#changes}}
                <li>{{text}}</li>
                {{/changes}}
            </ul>
            {{/haschanges}}
            {{#hasrecoverymarker}}
            <div class="text-muted">{{recoverymarkertext}}</div>
            {{/hasrecoverymarker}}
        </li>
        {{/historyentries}}
    </ul>
    {{/hashistoryentries}}
    {{^hashistoryentries}}
    <div class="small text-muted mt-2">{{historydetailsempty}}</div>
    {{/hashistoryentries}}
</details>
{{/showhistorydetails}}
{{/showoptions}}
{{^showoptions}}
<div class="mod-bookit-status-chip {{statusclass}} mod-bookit-status-chip-{{statusgroupkey}}"
     style="{{statusstyle}}">
    <div class="font-weight-bold">{{statustext}}</div>
    <div class="small">{{statusgrouptext}}</div>
</div>
{{#showhistorysummary}}
<div class="small text-muted mt-1">{{latesthistorysummary}}</div>
{{/showhistorysummary}}
{{#showhistorydetails}}
<details class="mt-2 text-left mod-bookit-history-details">
    <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
    {{#hashistoryentries}}
    <ul class="list-unstyled small mb-0 mt-2">
        {{#historyentries}}
        <li class="mb-2">
            <div>{{summary}}</div>
            {{#haschanges}}
            <ul class="mb-0 pl-3">
                {{#changes}}
                <li>{{text}}</li>
                {{/changes}}
            </ul>
            {{/haschanges}}
            {{#hasrecoverymarker}}
            <div class="text-muted">{{recoverymarkertext}}</div>
            {{/hasrecoverymarker}}
        </li>
        {{/historyentries}}
    </ul>
    {{/hashistoryentries}}
    {{^hashistoryentries}}
    <div class="small text-muted mt-2">{{historydetailsempty}}</div>
    {{/hashistoryentries}}
</details>
{{/showhistorydetails}}
{{/showoptions}}
