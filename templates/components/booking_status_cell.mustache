{{!
    @template mod_bookit/components/booking_status_cell
    Shared booking / resource status table cell (editable dropdown or read-only chip).

    Context variables: see booking_status_cell::export_for_template().

    Example context (json):
    {
        "cellclasses": "align-middle",
        "showoptions": true,
        "updateaction": "update-booking-status",
        "eventid": 1,
        "cmid": 12,
        "bookingstatus": 2,
        "statusstyle": "background-color:#fff;color:#000;",
        "options": [
            {"value": 1, "bg": "#fff", "fg": "#000", "label": "New", "selected": false},
            {"value": 2, "bg": "#fff", "fg": "#000", "label": "In progress", "selected": true}
        ],
        "statusgrouptext": "Active",
        "showhistorysummary": false,
        "showhistorydetails": false
    }
}}
<td class="{{cellclasses}}{{#showoptions}} text-center{{/showoptions}}">
    {{#showoptions}}
    <select class="custom-select custom-select-sm mod-bookit-status-select"
            data-action="{{updateaction}}"
            {{#eventid}}data-eventid="{{eventid}}"{{/eventid}}
            {{#cmid}}data-cmid="{{cmid}}"{{/cmid}}
            {{#itemid}}data-itemid="{{itemid}}"{{/itemid}}
            {{#bookingstatus}}data-bookingstatus="{{bookingstatus}}"{{/bookingstatus}}
            {{#requesttab}}data-tab="{{requesttab}}"{{/requesttab}}
            style="{{statusstyle}}">
        {{#options}}
        <option value="{{value}}" data-bg="{{bg}}" data-fg="{{fg}}" {{#selected}}selected{{/selected}}>{{label}}</option>
        {{/options}}
    </select>
    <div class="small text-muted mt-1">{{statusgrouptext}}</div>
    {{#showhistorysummary}}
    <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
    {{/showhistorysummary}}
    {{#showhistorydetails}}
    <details class="mt-2 text-left mod-bookit-history-details">
        <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
        {{#hashistoryentries}}
        <ul class="list-unstyled small mb-0 mt-2">
            {{#historyentries}}
            <li class="mb-2">
                <div>{{summary}}</div>
                {{#haschanges}}
                <ul class="mb-0 pl-3">
                    {{#changes}}
                    <li>{{text}}</li>
                    {{/changes}}
                </ul>
                {{/haschanges}}
                {{#hasrecoverymarker}}
                <div class="text-muted">{{recoverymarkertext}}</div>
                {{/hasrecoverymarker}}
            </li>
            {{/historyentries}}
        </ul>
        {{/hashistoryentries}}
        {{^hashistoryentries}}
        <div class="small text-muted mt-2">{{historydetailsempty}}</div>
        {{/hashistoryentries}}
    </details>
    {{/showhistorydetails}}
    {{/showoptions}}
    {{^showoptions}}
    <div class="mod-bookit-status-chip {{statusclass}} mod-bookit-status-chip-{{statusgroupkey}}"
         style="{{statusstyle}}">
        <div class="font-weight-bold">{{statustext}}</div>
        <div class="small">{{statusgrouptext}}</div>
    </div>
    {{#showhistorysummary}}
    <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
    {{/showhistorysummary}}
    {{#showhistorydetails}}
    <details class="mt-2 text-left mod-bookit-history-details">
        <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
        {{#hashistoryentries}}
        <ul class="list-unstyled small mb-0 mt-2">
            {{#historyentries}}
            <li class="mb-2">
                <div>{{summary}}</div>
                {{#haschanges}}
                <ul class="mb-0 pl-3">
                    {{#changes}}
                    <li>{{text}}</li>
                    {{/changes}}
                </ul>
                {{/haschanges}}
                {{#hasrecoverymarker}}
                <div class="text-muted">{{recoverymarkertext}}</div>
                {{/hasrecoverymarker}}
            </li>
            {{/historyentries}}
        </ul>
        {{/hashistoryentries}}
        {{^hashistoryentries}}
        <div class="small text-muted mt-2">{{historydetailsempty}}</div>
        {{/hashistoryentries}}
    </details>
    {{/showhistorydetails}}
    {{/showoptions}}
</td>
