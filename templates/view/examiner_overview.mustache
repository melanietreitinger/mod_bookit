{{!
    @template mod_bookit/overview/examiner_overview

    Examiner overview table with live search and sortable columns.
    The title link opens the event details ModalForm (handled by existing AMD JS).

    Classes required for JS:
    * bookit-event-link

    IDs required for JS:
    * bookit-filter

    Context variables required for this template:
    * tableid - The HTML id attribute value for the table element.
    * events - Array of event rows.

    Event row fields:
    * id - Event id.
    * name - Event title (already formatted).
    * room - Room label (string).
    * personincharge - Full name of the person in charge (string).
    * myrole - Role label for current user (string).
    * statustext - Booking status label (string).
    * statusstyle - Inline CSS for the status cell (string).
    * statusoptions - Array of {value, label, selected} for admin dropdown.
    * canmanage - Whether current user can manage events (bool).
    * datestr - Date string for display (string).
    * starttime - Unix timestamp used for sorting (number).
    * cmid - Course module id for the modal (number).
    * checklistprogress - Checklist progress percent (int, -1 = no master checklist).
    * checklistprogress_available - Whether checklist progress is available (bool).
    * resourcesprogress - Resources progress percent (int).
    * resourcesprogress_available - Whether resources progress is available (bool).
    * checklistlabel - Checklist button label (string).

    Example context (json):
    {
      "tableid": "overview-table",
      "events": [
        {
          "id": 123,
          "name": "Exam A",
          "room": "Room 1",
          "personincharge": "Jane Doe",
          "myrole": "Person in charge",
          "statustext": "Accepted",
          "statusstyle": "background-color:#d4edda;color:#000000;",
          "datestr": "14.01.2026",
          "starttime": 1768425600,
          "cmid": 42,
          "checklistprogress": 50,
          "checklistprogress_available": true,
          "resourcesprogress": 75,
          "resourcesprogress_available": true,
          "checklistlabel": "Checklist"
        }
      ]
    }
}}

<div class="mod_bookit-overview-examiner_overview">
    <div class="mb-3">
        <ul class="nav nav-tabs">
            {{#showmyeventsnav}}
            <li class="nav-item">
                <a class="nav-link {{#myeventsactive}}active{{/myeventsactive}}" href="{{myeventsurl}}">
                    {{myeventstitle}}
                </a>
            </li>
            {{/showmyeventsnav}}
            {{#showhistorynav}}
            <li class="nav-item">
                <a class="nav-link {{#historyactive}}active{{/historyactive}}" href="{{historyurl}}">
                    {{historytitle}}
                </a>
            </li>
            {{/showhistorynav}}
            {{#showopenrequestsnav}}
            <li class="nav-item">
                <a class="nav-link {{#openrequestsactive}}active{{/openrequestsactive}}" href="{{openrequestsurl}}">
                    {{openrequeststitle}}
                    <span class="badge badge-pill badge-warning ml-1">{{openrequestcount}}</span>
                </a>
            </li>
            {{/showopenrequestsnav}}
        </ul>
    </div>

    <div class="mb-3">
        <label for="bookit-filter" class="mr-2">{{#str}}search, core{{/str}}:</label>
        <input type="text" id="bookit-filter" class="form-control w-auto d-inline">
    </div>

    {{#showmyeventssection}}
    <div class="mb-3">
        <h3 class="h5 mb-0">{{sectiontitle}}</h3>
        {{#showoverviewfilters}}
        <div class="text-muted small mt-1">{{reportinghelp}}</div>
        {{/showoverviewfilters}}
    </div>
    {{#showoverviewfilters}}
    <form method="get" class="mb-3">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="tab" value="{{#historyactive}}history{{/historyactive}}{{^historyactive}}myevents{{/historyactive}}">
        <div class="form-row align-items-end">
            {{#showreportfilters}}
            <div class="form-group col-md-3">
                <label for="bookit-reportstart">{{reportstartlabel}}</label>
                <input type="date" id="bookit-reportstart" name="reportstart" class="form-control" value="{{reportstartvalue}}">
            </div>
            <div class="form-group col-md-3">
                <label for="bookit-reportend">{{reportendlabel}}</label>
                <input type="date" id="bookit-reportend" name="reportend" class="form-control" value="{{reportendvalue}}">
            </div>
            {{/showreportfilters}}
            <div class="form-group col-md-2">
                <label for="bookit-bookingstatusfilter">{{statusfilterlabel}}</label>
                <select id="bookit-bookingstatusfilter" name="bookingstatusfilter" class="form-control">
                    {{#statusfilteroptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/statusfilteroptions}}
                </select>
            </div>
            <div class="form-group col-md-2">
                <label for="bookit-facultyid">{{facultyfilterlabel}}</label>
                <select id="bookit-facultyid" name="facultyid" class="form-control">
                    {{#facultyoptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/facultyoptions}}
                </select>
            </div>
            <div class="form-group {{#showreportfilters}}col-md-2{{/showreportfilters}}{{^showreportfilters}}col-md-4{{/showreportfilters}}">
                <label for="bookit-semesterids">{{semesterfilterlabel}}</label>
                <select id="bookit-semesterids" name="semesterids[]" class="form-control" multiple size="4">
                    {{#semesteroptions}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/semesteroptions}}
                </select>
            </div>
            <div class="form-group col-md-2">
                <button type="submit" class="btn btn-primary btn-block mb-2">{{reportapplylabel}}</button>
                <a href="{{reportreseturl}}" class="btn btn-outline-secondary btn-block">{{reportresetlabel}}</a>
            </div>
        </div>
    </form>
    <div class="badge badge-info mb-3 p-2">{{eventcounttext}}</div>
    {{/showoverviewfilters}}
    {{#hasevents}}
    <table id="{{tableid}}" class="generaltable table-striped table-hover w-100">
        <thead class="text-center">
            <tr style="background-color:#cfe2ff;">
                {{#showidcolumn}}
                <th class="align-middle">ID</th>
                {{/showidcolumn}}
                <th class="align-middle">Title</th>
                <th class="align-middle">Room</th>
                <th class="align-middle">Person in charge</th>
                <th class="align-middle">My role</th>
                <th class="align-middle">Booking status</th>
                <th class="align-middle">Date</th>
                {{#showprogresscolumn}}
                <th class="align-middle">Progress</th>
                {{/showprogresscolumn}}
                {{#showchecklistcolumn}}
                <th class="align-middle">Checklist</th>
                {{/showchecklistcolumn}}
                {{#showresourcescolumn}}
                <th class="align-middle">Resources</th>
                {{/showresourcescolumn}}
            </tr>
        </thead>

        <tbody class="text-center">
            {{#events}}
                <tr class="mod-bookit-status-row mod-bookit-status-row-{{statusgroupkey}}">
                    {{#showidcolumn}}
                    <td class="align-middle">{{id}}</td>
                    {{/showidcolumn}}

                    <td class="align-middle">
                        {{#is_reserved_projection}}
                        <span data-is-reserved-projection="1">{{name}}</span>
                        {{/is_reserved_projection}}
                        {{^is_reserved_projection}}
                        {{#caneventdetails}}
                        <a href="#"
                           class="bookit-event-link"
                           data-eventid="{{id}}"
                           data-cmid="{{cmid}}"
                           data-is-reserved-projection="{{#is_reserved_projection}}1{{/is_reserved_projection}}{{^is_reserved_projection}}0{{/is_reserved_projection}}">
                            {{name}}
                        </a>
                        {{/caneventdetails}}
                        {{^caneventdetails}}{{name}}{{/caneventdetails}}
                        {{/is_reserved_projection}}
                    </td>

                    <td class="align-middle">{{room}}</td>
                    <td class="align-middle">{{personincharge}}</td>
                    <td class="align-middle">{{myrole}}</td>

                    {{#canmanage}}
                    <td class="align-middle text-center mod-bookit-status-cell">
                        <select class="custom-select custom-select-sm"
                                data-action="update-booking-status"
                                data-eventid="{{id}}"
                                data-cmid="{{cmid}}"
                                data-bookingstatus="{{bookingstatus}}">
                            {{#statusoptions}}
                            <option value="{{value}}" data-bg="{{bg}}" data-fg="{{fg}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/statusoptions}}
                        </select>
                        <div class="small text-muted mt-1">{{statusgrouptext}}</div>
                        {{#haslatesthistorysummary}}
                        <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
                        {{/haslatesthistorysummary}}
                    </td>
                    {{/canmanage}}
                    {{^canmanage}}
                    <td class="align-middle mod-bookit-status-cell">
                        <div class="mod-bookit-status-chip {{statusclass}} mod-bookit-status-chip-{{statusgroupkey}}"
                             style="{{statusstyle}}">
                            <div class="font-weight-bold">{{statustext}}</div>
                            <div class="small">{{statusgrouptext}}</div>
                        </div>
                        {{#haslatesthistorysummary}}
                        <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
                        {{/haslatesthistorysummary}}
                    </td>
                    {{/canmanage}}

                    <td class="align-middle" data-sort="{{starttime}}">{{datestr}}</td>

                    {{#showprogresscolumn}}
                    <td class="align-middle">
                        {{#checklistprogress_available}}
                        <div class="mb-1">
                            <div class="small text-muted mb-1">Checklist</div>
                            <div class="progress position-relative" style="min-width:80px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width:{{checklistprogress}}%;"
                                     aria-valuenow="{{checklistprogress}}"
                                     aria-valuemin="0" aria-valuemax="100">
                                </div>
                                <span class="position-absolute w-100 text-center" style="font-size:0.75rem;line-height:1rem;">{{checklistprogress}}%</span>
                            </div>
                        </div>
                        {{/checklistprogress_available}}
                        {{#resourcesprogress_available}}
                        <div>
                            <div class="small text-muted mb-1">Resources</div>
                            <div class="progress position-relative" style="min-width:80px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width:{{resourcesprogress}}%;"
                                     aria-valuenow="{{resourcesprogress}}"
                                     aria-valuemin="0" aria-valuemax="100">
                                </div>
                                <span class="position-absolute w-100 text-center" style="font-size:0.75rem;line-height:1rem;">{{resourcesprogress}}%</span>
                            </div>
                        </div>
                        {{/resourcesprogress_available}}
                        {{^checklistprogress_available}}{{^resourcesprogress_available}}--{{/resourcesprogress_available}}{{/checklistprogress_available}}
                    </td>
                    {{/showprogresscolumn}}
                    {{#showchecklistcolumn}}
                    <td class="align-middle">
                        {{#haschecklistaction}}
                        <a href="{{checklisturl}}" class="btn btn-sm btn-primary">{{checklistlabel}}</a>
                        {{/haschecklistaction}}
                        {{^haschecklistaction}}-{{/haschecklistaction}}
                    </td>
                    {{/showchecklistcolumn}}
                    {{#showresourcescolumn}}
                    <td class="align-middle">
                        {{#hasresourcesaction}}
                        <a href="{{resourceschecklisturl}}" class="btn btn-sm btn-primary">{{resourceschecklistlabel}}</a>
                        {{/hasresourcesaction}}
                        {{^hasresourcesaction}}-{{/hasresourcesaction}}
                    </td>
                    {{/showresourcescolumn}}
                </tr>
            {{/events}}
        </tbody>
    </table>
    {{#showoverviewfilters}}
    <div class="badge badge-info mt-3 p-2">{{eventcounttext}}</div>
    {{/showoverviewfilters}}
    {{/hasevents}}
    {{^hasevents}}
    <div class="alert alert-info">{{noeventsmessage}}</div>
    {{/hasevents}}
    {{/showmyeventssection}}

    {{#showrequestworkspacesection}}
    <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h3 class="h5 mb-1">{{requestworkspacetitle}}</h3>
            <div class="text-muted small">{{requestworkspacehelp}}</div>
        </div>
        <div class="badge badge-pill p-2 {{requestqueuebadgeclass}}">
            {{requestqueuecounttext}}
        </div>
    </div>

    {{#showrequestworkspaceswitch}}
    <div class="mb-3">
        <div class="text-muted small mb-2">{{requestqueueswitchhelp}}</div>
        <div class="btn-group mod-bookit-request-workspace-switch" role="group" aria-label="{{requestqueueswitchlabel}}">
            <a class="btn {{#requestworkspaceopenactive}}btn-warning active{{/requestworkspaceopenactive}}{{^requestworkspaceopenactive}}btn-outline-warning{{/requestworkspaceopenactive}}"
               href="{{openrequestsurl}}">
                {{openrequeststitle}}
                <span class="badge badge-pill badge-light ml-1">{{openrequestcount}}</span>
            </a>
            <a class="btn {{#requestworkspacerejectedactive}}btn-danger active{{/requestworkspacerejectedactive}}{{^requestworkspacerejectedactive}}btn-outline-danger{{/requestworkspacerejectedactive}}"
               href="{{rejectedrequestsurl}}">
                {{rejectedrequeststitle}}
                <span class="badge badge-pill badge-light ml-1">{{rejectedrequestcount}}</span>
            </a>
        </div>
    </div>
    {{/showrequestworkspaceswitch}}

    {{#requestworkspaceopenactive}}
    <div class="mb-3">
        <h4 class="h6 mb-1">{{requestqueuecurrenttitle}}</h4>
        <div class="text-muted small">{{requestqueuecurrenthelp}}</div>
    </div>

    {{#hasopenrequests}}
    <table id="{{tableid}}" class="generaltable table-striped table-hover w-100 mod-bookit-open-requests-table">
        <thead class="text-center">
            <tr style="background-color:#fff3cd;">
                <th class="align-middle">ID</th>
                <th class="align-middle">Title</th>
                <th class="align-middle">Room</th>
                <th class="align-middle">Person in charge</th>
                <th class="align-middle">My role</th>
                <th class="align-middle">Booking status</th>
                <th class="align-middle">Date</th>
                <th class="align-middle">Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
            {{#openrequests}}
            <tr class="mod-bookit-open-request-row mod-bookit-status-row mod-bookit-status-row-{{statusgroupkey}}">
                <td class="align-middle">{{id}}</td>
                <td class="align-middle">
                    {{#caneventdetails}}
                    <a href="#"
                       class="bookit-event-link"
                       data-eventid="{{id}}"
                       data-cmid="{{cmid}}">
                        {{name}}
                    </a>
                    {{/caneventdetails}}
                    {{^caneventdetails}}{{name}}{{/caneventdetails}}
                </td>
                <td class="align-middle">{{room}}</td>
                <td class="align-middle">{{personincharge}}</td>
                <td class="align-middle">{{myrole}}</td>
                <td class="align-middle mod-bookit-status-cell">
                    <div class="mod-bookit-status-chip {{statusclass}} mod-bookit-status-chip-{{statusgroupkey}}"
                         style="{{statusstyle}}">
                        <div class="font-weight-bold">{{statustext}}</div>
                        <div class="small">{{statusgrouptext}}</div>
                        {{#haslatesthistorysummary}}
                        <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
                        {{/haslatesthistorysummary}}
                        {{#showhistorydetails}}
                        <details class="mt-2 text-left mod-bookit-history-details">
                            <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
                            {{#hashistoryentries}}
                            <ul class="list-unstyled small mb-0 mt-2">
                                {{#historyentries}}
                                <li class="mb-2">
                                    <div>{{summary}}</div>
                                    {{#hasrecoverymarker}}
                                    <div class="text-info">{{recoverymarkertext}}</div>
                                    {{/hasrecoverymarker}}
                                    {{#haschanges}}
                                    <ul class="pl-3 mb-0">
                                        {{#changes}}
                                        <li>{{text}}</li>
                                        {{/changes}}
                                    </ul>
                                    {{/haschanges}}
                                </li>
                                {{/historyentries}}
                            </ul>
                            {{/hashistoryentries}}
                            {{^hashistoryentries}}
                            <div class="small text-muted mt-2">{{historydetailsempty}}</div>
                            {{/hashistoryentries}}
                        </details>
                        {{/showhistorydetails}}
                    </div>
                </td>
                <td class="align-middle" data-sort="{{starttime}}">{{datestr}}</td>
                <td class="align-middle">
                    <div class="d-flex flex-wrap justify-content-center mod-bookit-open-request-actions">
                        {{#actions}}
                        <button type="button"
                                class="btn btn-sm {{btnclass}}"
                                data-action="set-booking-status"
                                data-eventid="{{eventid}}"
                                data-cmid="{{cmid}}"
                                data-tab="{{tab}}"
                                data-status="{{value}}">
                            {{label}}
                        </button>
                        {{/actions}}
                    </div>
                </td>
            </tr>
            {{/openrequests}}
        </tbody>
    </table>
    {{/hasopenrequests}}

    {{^hasopenrequests}}
    <div class="alert alert-info mb-0">
        {{openrequestsempty}}
    </div>
    {{/hasopenrequests}}
    {{/requestworkspaceopenactive}}

    {{#requestworkspacerejectedactive}}
    <div class="mb-3">
        <div>
            <h4 class="h6 mb-1">{{requestqueuecurrenttitle}}</h4>
            <div class="text-muted small">{{requestqueuecurrenthelp}}</div>
        </div>
    </div>

    {{#hasrejectedrequests}}
    <table id="{{tableid}}" class="generaltable table-striped table-hover w-100 mod-bookit-rejected-requests-table">
        <thead class="text-center">
            <tr style="background-color:#f8d7da;">
                <th class="align-middle">ID</th>
                <th class="align-middle">Title</th>
                <th class="align-middle">Room</th>
                <th class="align-middle">Person in charge</th>
                <th class="align-middle">My role</th>
                <th class="align-middle">Booking status</th>
                <th class="align-middle">Date</th>
                <th class="align-middle">Actions</th>
            </tr>
        </thead>
        <tbody class="text-center">
            {{#rejectedrequests}}
            <tr class="mod-bookit-rejected-request-row mod-bookit-status-row mod-bookit-status-row-{{statusgroupkey}}">
                <td class="align-middle">{{id}}</td>
                <td class="align-middle">
                    {{#caneventdetails}}
                    <a href="#"
                       class="bookit-event-link"
                       data-eventid="{{id}}"
                       data-cmid="{{cmid}}">
                        {{name}}
                    </a>
                    {{/caneventdetails}}
                    {{^caneventdetails}}{{name}}{{/caneventdetails}}
                </td>
                <td class="align-middle">{{room}}</td>
                <td class="align-middle">{{personincharge}}</td>
                <td class="align-middle">{{myrole}}</td>
                <td class="align-middle mod-bookit-status-cell">
                    <div class="mod-bookit-status-chip {{statusclass}} mod-bookit-status-chip-{{statusgroupkey}}"
                         style="{{statusstyle}}">
                        <div class="font-weight-bold">{{statustext}}</div>
                        <div class="small">{{statusgrouptext}}</div>
                        {{#haslatesthistorysummary}}
                        <div class="small text-muted mt-1">{{latesthistorysummary}}</div>
                        {{/haslatesthistorysummary}}
                        {{#showhistorydetails}}
                        <details class="mt-2 text-left mod-bookit-history-details">
                            <summary class="small font-weight-bold">{{historydetailslabel}}</summary>
                            {{#hashistoryentries}}
                            <ul class="list-unstyled small mb-0 mt-2">
                                {{#historyentries}}
                                <li class="mb-2">
                                    <div>{{summary}}</div>
                                    {{#hasrecoverymarker}}
                                    <div class="text-info">{{recoverymarkertext}}</div>
                                    {{/hasrecoverymarker}}
                                    {{#haschanges}}
                                    <ul class="pl-3 mb-0">
                                        {{#changes}}
                                        <li>{{text}}</li>
                                        {{/changes}}
                                    </ul>
                                    {{/haschanges}}
                                </li>
                                {{/historyentries}}
                            </ul>
                            {{/hashistoryentries}}
                            {{^hashistoryentries}}
                            <div class="small text-muted mt-2">{{historydetailsempty}}</div>
                            {{/hashistoryentries}}
                        </details>
                        {{/showhistorydetails}}
                    </div>
                </td>
                <td class="align-middle" data-sort="{{starttime}}">{{datestr}}</td>
                <td class="align-middle">
                    <div class="d-flex flex-wrap justify-content-center mod-bookit-open-request-actions">
                        {{#actions}}
                        <button type="button"
                                class="btn btn-sm {{btnclass}}"
                                data-action="set-booking-status"
                                data-eventid="{{eventid}}"
                                data-cmid="{{cmid}}"
                                data-tab="{{tab}}"
                                data-status="{{value}}">
                            {{label}}
                        </button>
                        {{/actions}}
                    </div>
                </td>
            </tr>
            {{/rejectedrequests}}
        </tbody>
    </table>
    {{/hasrejectedrequests}}

    {{^hasrejectedrequests}}
    <div class="alert alert-info mb-0">
        {{rejectedrequestsempty}}
    </div>
    {{/hasrejectedrequests}}
    {{/requestworkspacerejectedactive}}
    {{/showrequestworkspacesection}}
</div>
