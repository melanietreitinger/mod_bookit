{{!
    @template mod_bookit/view/export_events_modal

    Export-events selection modal used by the Bookit calendar view.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    IDs required for JS (used by mod_bookit/export_modal AMD module):
    * bookit-export-modal
    * bookit-modal-search
    * bookit-export-start
    * bookit-export-end
    * bookit-export-reset-range
    * bookit-check-all
    * bookit-uncheck-all
    * bookit-export-list
    * bookit-export-confirm

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<div class="modal fade" id="bookit-export-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">{{#str}}exportevents, mod_bookit{{/str}}</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
<p class="bookit-export-instruction mb-3">{{#str}}selectevents, mod_bookit{{/str}}</p>
                <div class="mb-3 bookit-export-toolbar">
                    <label for="bookit-modal-search" class="mb-1 font-weight-bold">
                        {{#str}}search, core{{/str}}:
                    </label>
                    <input
                        type="text"
                        id="bookit-modal-search"
                        class="form-control bookit-export-search"
                        placeholder="{{#str}}search, core{{/str}}">
                </div>

                <div class="mb-3 bookit-export-toolbar">
                    <div class="form-row align-items-end">
                        <div class="form-group col-md-4 mb-2">
                            <label for="bookit-export-start" class="mb-1 font-weight-bold">
                        {{#str}}exportevents_from, mod_bookit{{/str}}
                            </label>
                            <input type="date" id="bookit-export-start" class="form-control">
                        </div>
                        <div class="form-group col-md-4 mb-2">
                            <label for="bookit-export-end" class="mb-1 font-weight-bold">
                        {{#str}}exportevents_to, mod_bookit{{/str}}
                            </label>
                            <input type="date" id="bookit-export-end" class="form-control">
                        </div>
                        <div class="form-group col-md-4 mb-2">
                            <button type="button" class="btn btn-secondary" id="bookit-export-reset-range">                                {{#str}}exportevents_reset_range, mod_bookit{{/str}}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mb-2">
                    <div id="bookit-export-selection-count" class="font-weight-bold" aria-live="polite">                        {{#str}}exportevents_selectedcount, mod_bookit, 0{{/str}}
                    </div>
                </div>
                <div class="mb-3 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary mr-1" id="bookit-check-all">                        {{#str}}selectall, core{{/str}}
                    </button>
                    <button type="button" class="btn btn-secondary" id="bookit-uncheck-all">
                        {{#str}}deselectall, core{{/str}}
                    </button>
                </div>

                <div id="bookit-export-list" class="list-group small bookit-export-list"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    {{#str}}cancel, core{{/str}}
                </button>
                <button type="button" class="btn btn-primary" id="bookit-export-confirm" disabled>
                    {{#str}}export, mod_bookit{{/str}}
                </button>
            </div>
        </div>
    </div>
</div>
